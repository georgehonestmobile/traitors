# --- Admin GUI ---
# Password you'll use to log in to the admin GUI.
ADMIN_PASSWORD=change-me

# Timezone used to display times in the admin GUI (Slack shows each player their own timezone).
APP_TIMEZONE=Europe/London

# --- Slack (from your Slack app's settings) ---
# OAuth & Permissions -> Bot User OAuth Token (starts xoxb-)
SLACK_BOT_TOKEN=
# Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=

# --- Storage (Upstash Redis via the Vercel Marketplace sets these automatically) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Leave SLACK_BOT_TOKEN empty locally to run in DEMO mode: fake players, DMs logged to the console.
# Leave KV_* empty locally to use an in-memory store (data is lost on restart).
